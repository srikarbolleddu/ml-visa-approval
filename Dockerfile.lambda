# Lambda container image -- what CI deploys (see infra/README.md). The AWS base image already
# wires up the Lambda Runtime Interface Client.
FROM public.ecr.aws/lambda/python:3.13

COPY --from=ghcr.io/astral-sh/uv:0.9.26 /uv /uvx /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy

# Runtime dependencies only: the `dev` and `train` groups (pytest, matplotlib, ...) stay out.
COPY pyproject.toml uv.lock ./
RUN uv export --frozen --no-default-groups --no-emit-project --format requirements-txt > requirements.txt \
    && pip install --no-cache-dir -r requirements.txt -t "${LAMBDA_TASK_ROOT}"

# app/ includes model_artifacts/ (the trained model, its manifest, demo samples, explore data).
COPY app "${LAMBDA_TASK_ROOT}/app"

CMD ["app.lambda_handler.handler"]
